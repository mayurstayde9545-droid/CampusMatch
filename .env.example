# Copy this file to .env for local XAMPP/MySQL use, then fill in your own values.
# Keep .env private; never commit or send it to anyone.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=campusmatch
# For hosted databases only, set MYSQL_SSL=true when your provider requires TLS.
MYSQL_SSL=false
# For hosted MySQL, paste your provider's CA certificate here and set MYSQL_SSL=true.
# Keep this value private and never commit your real .env file.
MYSQL_SSL_CA=

